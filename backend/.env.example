# ==========================================================
# Campus Event Management & QR Ticketing Platform
# Backend Environment Configuration Template
# ==========================================================

# Node Environment: 'development' | 'production' | 'test'
# On Render: Set to 'production'
NODE_ENV=production

# Server Port (On Render, this is dynamically provided by the platform)
PORT=5001

# MongoDB Connection URI:
# For local development: mongodb://127.0.0.1:27018/campus_events?replicaSet=rs0
# For production (MongoDB Atlas): mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/campus_events?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/campus_events?retryWrites=true&w=majority

# Frontend URL (Used for CORS and cookie origin matching)
# In development: http://localhost:5174
# In production: https://<your-app>.vercel.app
FRONTEND_URL=https://<your-app>.vercel.app

# JWT Secret Key (Cryptographically secure string, minimum 32 characters)
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# Google Gemini API Configuration (Backend-Only, never expose to client)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Initial Admin Bootstrap (Optional for seeding initial admin)
ADMIN_NAME=Campus Administrator
ADMIN_EMAIL=admin@campus.edu
ADMIN_PASSWORD=AdminPass123!
